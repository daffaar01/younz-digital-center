# =============================================================
# Younz Digital Center — Backend Laravel
# Salin file ini menjadi .env lalu isi nilainya.
# Jangan pernah commit file .env ke repository.
# =============================================================

APP_NAME="Younz Digital Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
BACKEND_ONLY=true
TRUSTED_HOSTS=localhost,127.0.0.1
STAFF_URL=http://localhost:3000
STAFF_ACCESS_CODE_HASH=
STAFF_ACCESS_TTL_MINUTES=60

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# --- WhatsApp gateway ----------------------------------------
WA_NUMBER=6281234567890
WA_DISPLAY_NUMBER=081234567890
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3000
WHATSAPP_INTERNAL_TOKEN=
WHATSAPP_GATEWAY_TIMEOUT=10
WHATSAPP_LOG_LEVEL=info
STORE_ADDRESS="JL. Kapten Mulyono No. 60C"
STORE_OPEN_HOURS="Senin - Sabtu 09:00 - 17:00"

# --- Database ------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=younz_digital_center
DB_USERNAME=root
DB_PASSWORD=

# Production dapat memakai pgsql; CI memakai pgsql + redis.
# DB_CONNECTION=pgsql
# DB_PORT=5432

# --- Cache / Queue / Session ---------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Production disarankan Redis:
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Log & Mail ----------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=debug

MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="noreply@younzdigitalcenter.my.id"
# MAIL_FROM_NAME="${APP_NAME}"
# SECURITY_ALERT_EMAIL=

# --- Firebase Auth (Google) ----------------------------------
FIREBASE_AUTH_ENABLED=false
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# --- Younz AI (OpenAI-compatible) ----------------------------
AI_PROVIDER=openai-compatible
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_TIMEOUT=120
AI_PROVIDER_ATTEMPTS=2
AI_PROVIDER_RETRY_DELAY_MS=250
AI_PROVIDER_FAILURE_THRESHOLD=3
AI_PROVIDER_COOLDOWN_SECONDS=30
AI_HISTORY_MESSAGES=12
AI_MESSAGE_CHARACTERS=3000
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_REQUESTS=500
AI_DAILY_TOKENS=200000

# --- Digiflazz (PPOB / top-up) --------------------------------
DIGIFLAZZ_ENABLED=false
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_TESTING=true
DIGIFLAZZ_WEBHOOK_SECRET=
DIGIFLAZZ_PREPAID_MARKUP=2000
DIGIFLAZZ_PREPAID_ROUNDING_UNIT=1000
DIGIFLAZZ_POSTPAID_ADMIN_FEE=4000
YOUNZ_PPOB_AGENT_TOKEN=
YOUNZ_PPOB_OPERATOR_TOKEN=
# Argon2id/Bcrypt hash of the private WhatsApp operator confirmation code.
YOUNZ_PPOB_WHATSAPP_CONFIRMATION_HASH=
# Comma-separated WhatsApp numbers allowed to execute direct PPOB purchases.
YOUNZ_PPOB_WHATSAPP_OPERATOR_NUMBERS=

# --- Midtrans Snap -------------------------------------------
MIDTRANS_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false
MIDTRANS_EXPIRY_MINUTES=60
MIDTRANS_NOTIFICATION_URL=https://example.com/webhooks/midtrans
TOPUP_ACCESS_LINK_DAYS=7

# --- YOUNZ ERP read-only transaction sync --------------------
# Use the same server-only value on the ERP API bridge.
YOUNZ_ERP_SYNC_TOKEN=

# --- Discord bot notification --------------------------------
DISCORD_NOTIFY_ENABLED=false
DISCORD_BOT_WEBHOOK_URL=http://localhost:3200
# Laravel menambahkan path /notify secara otomatis ke URL ini.
DISCORD_BOT_WEBHOOK_TOKEN=
DISCORD_BOT_TIMEOUT=8

# --- File & antivirus ----------------------------------------
ANTIVIRUS_DRIVER=clamav
ANTIVIRUS_BINARY=
ANTIVIRUS_REQUIRED=false
ANTIVIRUS_SCAN_TIMEOUT=30
SERVICE_FILE_RETENTION_DAYS=90
SERVICE_ORDER_MAX_REVISIONS=3
SANCTUM_TOKEN_EXPIRATION_DAYS=30
CORS_ALLOWED_ORIGINS=

# --- Backup ---------------------------------------------------
FILESYSTEM_DISK=local
DIGITAL_PRODUCT_DISK=local
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=30
# Optional; XAMPP/PATH detection is used when blank. Never put passwords here.
MARIADB_DUMP_BINARY=
MARIADB_CLIENT_BINARY=
BACKUP_R2_ENABLED=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=false
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# --- Approval & seed (jangan aktifkan di production) ----------
SEED_DEMO_USERS=false
SEED_OWNER_PASSWORD=
SEED_CASHIER_PASSWORD=
REFUND_OWNER_THRESHOLD=500000
APPROVAL_EXPIRES_AFTER_HOURS=24
APPROVAL_REQUIRE_SEPARATE_APPROVER=true
APPROVAL_ALLOW_SECOND_OWNER_BOOTSTRAP=true
