# =============================================================
# Younz Digital Center - Discord Bot
# Salin file ini menjadi .env lalu isi nilainya.
# Jangan pernah commit file .env ke repository.
# =============================================================

# --- Wajib -----------------------------------------------------
# Token bot dari https://discord.com/developers/applications
DISCORD_TOKEN=
# Application ID (Client ID) bot
DISCORD_CLIENT_ID=
# ID server Discord utama
DISCORD_GUILD_ID=
# --- Channel & Role -------------------------------------------
# Channel tujuan notifikasi pesanan, top up, dan approval
CHANNEL_NOTIFICATION_ID=
# Channel log moderasi dan audit bot
CHANNEL_LOG_ID=
# Channel sambutan member baru
CHANNEL_WELCOME_ID=
# Kategori tempat channel tiket dibuat
CATEGORY_TICKET_ID=
# Role staff yang boleh menangani tiket dan kontrol server
ROLE_STAFF_ID=
# Role yang diberikan otomatis ke member baru (opsional)
ROLE_AUTO_ID=

# --- Kanal navigasi (YOUNZSTATION) ----------------------------
# Kanal informasi umum: ringkasan pesanan & approval
CHANNEL_YOUNZ_INFORMATION_ID=
# Kanal sukses transaksi: isi dengan ID "✅・transaction-success"
CHANNEL_TRANSACTION_SUCCESS_ID=
# Kanal gagal transaksi: isi dengan ID "❌・transaction-failed"
CHANNEL_TRANSACTION_FAILED_ID=
# Kanal error internal bot: isi dengan ID "⚠️・bot-errors"
CHANNEL_BOT_ERRORS_ID=

# --- Kanal publik YOUNZSTATION -------------------------------
CHANNEL_DAFTAR_LAYANAN_ID=
CHANNEL_PROMO_UPDATE_ID=
CHANNEL_ORDER_LAYANAN_ID=
CHANNEL_TESTIMONI_ID=
CHANNEL_CUSTOMER_SUPPORT_ID=

# --- Integrasi Younz Digital Center ---------------------------
# Base URL Laravel yang dapat dijangkau bot
YOUNZ_API_URL=https://admin.younzdigitalcenter.my.id
# Base URL backend Laravel langsung (bukan domain publik Next.js).
# Dipakai untuk mem-follow signed URL status top up yang aslinya
# menunjuk ke domain publik yang melayani HTML. Contoh lokal: http://127.0.0.1:8081
YOUNZ_BACKEND_URL=
# Token Sanctum milik akun staff untuk membaca ringkasan dashboard
YOUNZ_API_TOKEN=
# Token bersama untuk memverifikasi webhook dari Laravel (minimal 32 karakter)
WEBHOOK_TOKEN=
# Dengarkan pada semua interface agar allocation hosting dapat menerima request
WEBHOOK_HOST=0.0.0.0
# Port tempat server webhook menerima notifikasi dari Laravel
SERVER_PORT=3200
# Toleransi selisih waktu request HMAC, dalam detik
WEBHOOK_MAX_SKEW_SECONDS=300

OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_TIMEOUT=120
AI_HISTORY_MESSAGES=12
AI_MESSAGE_CHARACTERS=3000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_REQUESTS_PER_WINDOW=8
AI_REQUEST_WINDOW_MS=60000

# --- Anti-spam ------------------------------------------------
# Jumlah pesan maksimum dalam jendela waktu sebelum dianggap spam
ANTISPAM_MAX_MESSAGES=6
# Panjang jendela waktu anti-spam dalam milidetik
ANTISPAM_WINDOW_MS=7000
# Lama timeout otomatis dalam menit ketika spam terdeteksi
ANTISPAM_TIMEOUT_MINUTES=10

# --- Lain-lain ------------------------------------------------
# trace, debug, info, warn, error
LOG_LEVEL=info
# Zona waktu untuk format tanggal pada embed
TIMEZONE=Asia/Jakarta
